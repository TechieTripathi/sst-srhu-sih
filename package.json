{
  "name": "techforge3-ui",
  "private": true,
  "description": "Tailwind build for the TechForge 3.0 Flask templates. Output (public/static/css/app.css) is committed.",
  "scripts": {
    "build:css": "tailwindcss -i public/static/css/src/app.css -o public/static/css/app.css --minify",
    "watch:css": "tailwindcss -i public/static/css/src/app.css -o public/static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/forms": "^0.5.9",
    "tailwindcss": "^4.1.0"
  }
}
